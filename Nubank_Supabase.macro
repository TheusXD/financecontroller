{
  "macro_name": "Nubank_para_Supabase",
  "endpoint": "https://SEU_PROJETO.supabase.co/rest/v1/transacoes",
  "apikey": "SUA_CHAVE_ANON_DO_SUPABASE",
  "trigger": "Notificação do Nubank Recebida",
  "regex_valor": "R\\$\\s*(\\d+[.,]\\d{2})",
  "regex_estabelecimento": "(?:em|no|na|para)\\s+([A-Za-z0-9\\s\\.\\-_*]+?)(?:\\s+aprovad[ao]|\\.|$|\\s+via)",
  "instructions": "Dica: Baixe a macro pré-preenchida com suas chaves diretamente na aba 'Open Finance & Automações' do seu Dashboard autenticado."
}
